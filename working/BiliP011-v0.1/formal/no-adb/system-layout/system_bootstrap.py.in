"""P011 SysV candidate: prepare this device's own data, then start fixed Bili.

Python 3.5 compatible. No ADB, shell command execution, radio, stock process,
mount, firmware, or partition operation. Never import development account data.
"""
from __future__ import print_function
import os
import re
import signal
import stat
import subprocess
import sys
import time

RELEASE_ID = '@RELEASE_ID@'
RELEASE = '/opt/p011-bili/releases/' + RELEASE_ID
APP = RELEASE + '/app'
AREA = '/mnt/data/p011-toolbox'
RUNTIME = AREA + '/bili-awake/' + RELEASE_ID
SERVICE = APP + '/formal_service.py'
PYTHON = '/usr/bin/python3'


def require(condition, message):
    if not condition:
        raise RuntimeError(message)


def mounted_userdata(text):
    rows = [line.split() for line in text.splitlines() if len(line.split()) >= 4]
    mounted = [row for row in rows if row[1] == '/mnt/data']
    require(len(mounted) == 1, 'one userdata data mount required')
    row = mounted[0]
    require(row[0] == '/dev/mmcblk0p40' and row[2] == 'ext4' and
            'rw' in row[3].split(','), 'supported writable userdata mount required')
    return True


def normal_boot(cmdline):
    require(not re.search(r'(?:^|\s)linuxboot\.mode=(?:cali|autotest|factorytest|charge)(?:\s|$)', cmdline)
            and not re.search(r'(?:^|\s)update_recovery=1(?:\s|$)', cmdline),
            'special boot mode excluded')
    return True


def read(path, limit=65536):
    with open(path, 'rb') as stream:
        raw = stream.read(limit + 1)
    require(len(raw) <= limit, 'read bound exceeded')
    return raw


def private_directory(path, area, uid):
    require(os.path.isabs(area) and os.path.normpath(area) == area and
            (path == area or path.startswith(area + '/')) and
            os.path.normpath(path) == path, 'noncanonical owned directory')
    current = ''
    for part in path.strip('/').split('/'):
        current += '/' + part
        if not os.path.lexists(current):
            require(current == area or current.startswith(area + '/'), 'data ancestor missing')
            os.mkdir(current, 0o700)
        info = os.lstat(current)
        require(stat.S_ISDIR(info.st_mode) and not stat.S_ISLNK(info.st_mode) and
                info.st_uid == uid, 'unsafe data directory')
        if current == area or current.startswith(area + '/'):
            require(not (stat.S_IMODE(info.st_mode) & 0o077), 'private data directory permissions differ')
    return path


def prepare_directories(area, release_id, uid):
    require(re.match(r'^[a-f0-9]{24}$', release_id) is not None, 'invalid release identity')
    names = ('', '/bili-awake', '/bili-awake/' + release_id,
             '/bili-awake/' + release_id + '/tmp',
             '/bili-awake/' + release_id + '/cache',
             '/bili-account', '/bili-preferences', '/bili-library',
             '/bili-home', '/bili-config')
    return [private_directory(area + name, area, uid) for name in names]


def prepare():
    require(os.getuid() == 0 and os.uname()[4] == 'armv7l', 'P011 root ARMv7 required')
    require(os.path.realpath(os.path.dirname(__file__)) == RELEASE, 'immutable release location differs')
    require('z031_v2.4.0-20251128_174826-user' in read('/etc/os-release').decode('ascii'),
            'supported firmware identity required')
    normal_boot(read('/proc/cmdline', 8192).decode('ascii'))
    mounted_userdata(read('/proc/mounts').decode('ascii'))
    return prepare_directories(AREA, RELEASE_ID, 0)


def process(pid):
    path = '/proc/' + str(pid)
    try:
        before = read(path + '/stat', 8192)
        fields = before[before.rindex(b')') + 2:].split()
        row = dict(pid=int(pid), start=fields[19], state=fields[0],
                   exe=os.readlink(path + '/exe'), uid=os.stat(path).st_uid,
                   args=read(path + '/cmdline').split(b'\0')[:-1])
        after = read(path + '/stat', 8192)
        require(after[after.rindex(b')') + 2:].split()[19] == row['start'], 'PID changed')
        return row
    except (FileNotFoundError, ProcessLookupError):
        return None


def ours(row):
    return bool(row and row['pid'] > 1 and row['uid'] == 0 and
                row['state'] not in (b'Z', b'X', b'D', b'T', b't') and
                row['exe'] == os.path.realpath(PYTHON) and
                row['args'] == [PYTHON.encode('ascii'), b'-B', SERVICE.encode('ascii')])


def service_rows():
    rows = [process(name) for name in os.listdir('/proc') if name.isdigit()]
    matching = [row for row in rows if row and SERVICE.encode('ascii') in row['args']]
    require(len(matching) <= 1 and all(ours(row) for row in matching), 'service process identity differs')
    return matching


def stop_row(row):
    current = process(row['pid'])
    if not current or current['start'] != row['start']:
        return
    require(ours(current) and current['exe'] == row['exe'], 'signal identity changed')
    os.kill(row['pid'], signal.SIGTERM)
    deadline = time.monotonic() + 23
    while time.monotonic() < deadline:
        current = process(row['pid'])
        if not current or current['start'] != row['start'] or current['state'] in (b'Z', b'X'):
            return
        time.sleep(.1)
    raise RuntimeError('normal service stop unconfirmed; no forced kill')


def endpoint_identity():
    path = RUNTIME + '/bili-endpoint.json'
    if not os.path.lexists(path):
        return None
    info = os.lstat(path)
    require(stat.S_ISREG(info.st_mode) and info.st_uid == 0 and info.st_nlink == 1,
            'unsafe endpoint')
    raw = read(path, 256)
    return info.st_dev, info.st_ino, info.st_mtime_ns, raw


def start():
    if service_rows():
        return
    old_endpoint = endpoint_identity()
    env = dict(os.environ, HOME=AREA + '/bili-home', XDG_RUNTIME_DIR='/run/user/0',
               WAYLAND_DISPLAY='wayland-0', TMPDIR=RUNTIME + '/tmp',
               XDG_CACHE_HOME=RUNTIME + '/cache', XDG_CONFIG_HOME=AREA + '/bili-config')
    for name in ('PYTHONPATH', 'PYTHONHOME', 'LD_PRELOAD', 'LD_LIBRARY_PATH',
                 'http_proxy', 'https_proxy', 'all_proxy', 'HTTP_PROXY', 'HTTPS_PROXY', 'ALL_PROXY'):
        env.pop(name, None)
    with open(os.devnull, 'r+b') as null:
        child = subprocess.Popen([PYTHON, '-B', SERVICE], cwd=APP, env=env,
                                 stdin=null, stdout=null, stderr=null,
                                 close_fds=True, start_new_session=True)
    deadline = time.monotonic() + 15
    try:
        while time.monotonic() < deadline:
            require(child.poll() is None, 'service exited during start')
            row = process(child.pid)
            require(ours(row), 'new service identity differs')
            endpoint = endpoint_identity()
            if endpoint is not None and endpoint != old_endpoint:
                # Use the bundled JSON implementation, not missing device stdlib.
                sys.path.insert(0, APP + '/stdlib-json35.zip')
                import json
                value = json.loads(endpoint[3].decode('ascii'))
                if (set(value) == {'url', 'formal'} and value['formal'] is True and
                        re.match(r'^http://127\.0\.0\.1:[1-9][0-9]{0,4}$', value['url'])):
                    return
            time.sleep(.1)
        raise RuntimeError('new loopback endpoint not ready')
    except Exception:
        row = process(child.pid)
        if ours(row):
            stop_row(row)
        raise


def main():
    require(len(sys.argv) == 2 and sys.argv[1] in ('start', 'stop'), 'fixed start/stop required')
    prepare()
    import fcntl
    lock = os.open(RUNTIME + '/system-start.lock', os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW, 0o600)
    try:
        info = os.fstat(lock)
        require(stat.S_ISREG(info.st_mode) and info.st_uid == 0 and info.st_nlink == 1 and
                not (stat.S_IMODE(info.st_mode) & 0o077), 'unsafe startup lock')
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        if sys.argv[1] == 'start':
            start()
        else:
            for row in service_rows():
                stop_row(row)
    finally:
        os.close(lock)


if __name__ == '__main__':
    try:
        main()
    except Exception:
        print('P011_BILI_SYSTEM_START_STOP_UNCONFIRMED', file=sys.stderr)
        raise SystemExit(1)
