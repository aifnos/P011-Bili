set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR armv7)
set(CMAKE_C_COMPILER /opt/p011/sdk/bin/arm-buildroot-linux-gnueabihf-gcc)
set(CMAKE_CXX_COMPILER /opt/p011/sdk/bin/arm-buildroot-linux-gnueabihf-g++)
set(CMAKE_AR /opt/p011/sdk/bin/arm-buildroot-linux-gnueabihf-ar)
set(CMAKE_RANLIB /opt/p011/sdk/bin/arm-buildroot-linux-gnueabihf-ranlib)
set(CMAKE_FIND_ROOT_PATH /work/p011/prefix /opt/p011/sdk/arm-buildroot-linux-gnueabihf/sysroot)
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
set(CMAKE_C_FLAGS_INIT "-march=armv7-a -mfpu=neon -mfloat-abi=hard -I/work/p011/prefix/include")
set(CMAKE_CXX_FLAGS_INIT "-march=armv7-a -mfpu=neon -mfloat-abi=hard -I/work/p011/prefix/include")
set(CMAKE_EXE_LINKER_FLAGS_INIT "-L/work/p011/prefix/lib -Wl,-rpath-link,/work/p011/prefix/lib -Wl,--allow-shlib-undefined")
set(CMAKE_SHARED_LINKER_FLAGS_INIT "-L/work/p011/prefix/lib -Wl,-rpath-link,/work/p011/prefix/lib -Wl,--allow-shlib-undefined")
set(CMAKE_INSTALL_PREFIX /work/p011/prefix CACHE PATH "Private build prefix")
set(CMAKE_POSITION_INDEPENDENT_CODE ON)
